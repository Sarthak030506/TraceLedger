# ── Blockchain ────────────────────────────────────────────────────────────────
# Anchoring mode is derived from what is set (see backend/services/blockchain.py):
#   none of RPC_URL / CONTRACT_ADDRESS / PRIVATE_KEY -> "simulated" (fake anchors, status=simulated)
#   RPC_URL + CONTRACT_ADDRESS                        -> "read_only" (verification reads the chain)
#   RPC_URL + CONTRACT_ADDRESS + PRIVATE_KEY          -> "live"      (real transactions)
# Any other combination is rejected instead of silently simulating.
#
# MST testnets (see blockchain/hardhat.config.js):
#   Coral:  https://coralrpc.mstblockchain.com   chain 54635
#   Legacy: https://testnetrpc.mstblockchain.com chain 91562037
RPC_URL=https://coralrpc.mstblockchain.com
CHAIN_ID=54635

# Deployed contract address (after: cd blockchain && npx hardhat run scripts/deploy.js --network mstTestnet)
CONTRACT_ADDRESS=

# Anchoring wallet private key. NEVER commit a real key; use a throwaway testnet wallet.
PRIVATE_KEY=

# Optional alternative: Sepolia (EVM-compatible) — used only if RPC_URL is unset
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_DB_PATH=data/backend.db
SIDECAR_DB_PATH=data/records.db

# Shared secret required in the X-API-Key header for POST /api/batches.
# REQUIRED in live mode (writes are refused without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_API_KEY=

# Optional: hex Ed25519 public key. When set, every submitted batch must carry a valid
# signature over the commitment fields (integrity.signer.commitment_signing_payload),
# and /verify re-checks it. Generate a pair with integrity.signer.generate_keypair().
BATCH_SIGNER_PUBLIC_KEY=

# Comma-separated browser origins allowed to call the API (default "*").
# CORS_ORIGINS=https://your-frontend.vercel.app

# ── Sidecar receiver ──────────────────────────────────────────────────────────
SIDECAR_API_KEY=your_sidecar_api_key_secret_here

# ── Demo expense app ──────────────────────────────────────────────────────────
# DEMO_USERS=alice:password123,bob:builder456

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# Set this in Vercel dashboard: https://vercel.com → Project → Settings → Environment Variables
# VITE_API_BASE_URL=https://your-backend.onrender.com
